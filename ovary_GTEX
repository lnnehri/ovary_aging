age_usage_results <- target_long %>%
  filter(!is.na(cdna_usage), !is.na(age_num)) %>%
  group_by(gene_id, transcript_id) %>%
  filter(n_distinct(age_num) >= 4) %>%
  summarise(
    n_samples = n(),
    rho = cor(age_num, cdna_usage, method = "spearman"),
    p_value = cor.test(
      age_num,
      cdna_usage,
      method = "spearman",
      exact = FALSE
    )$p.value,
    .groups = "drop"
  ) %>%
  mutate(
    FDR = p.adjust(p_value, method = "BH")
  )

