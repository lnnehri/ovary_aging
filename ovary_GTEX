age_usage_results %>%
  filter(FDR < 0.05) %>%
  summarise(
    significant = n(),
    increasing = sum(rho > 0),
    decreasing = sum(rho < 0),
    strong = sum(abs(rho) >= 0.3),
    very_strong = sum(abs(rho) >= 0.5)
  )
age_usage_results <- age_usage_results %>%
  mutate(
    status = case_when(
      FDR < 0.05 & rho > 0 ~ "Increasing with age",
      FDR < 0.05 & rho < 0 ~ "Decreasing with age",
