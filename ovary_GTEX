#merging
ovary_tpm_clean <- copy(ovary_tpm)

for (g in unique(redundant_decisions$redundant_group)) {
  
  x <- redundant_decisions %>%
    filter(redundant_group == g)
  
  keep_id <- x$transcript_id[x$decision == "KEEP"]
  merge_ids <- x$transcript_id[x$decision == "MERGE"]
  
  # MERGE transcriptlerinin TPM'lerini KEEP transcriptine ekle
  ovary_tpm_clean[
    transcript_id == keep_id,
    (sample_cols) := lapply(
      sample_cols,
      function(col)
        get(col) + colSums(
          ovary_tpm_clean[transcript_id %in% merge_ids, ..col]
        )
    )
  ]
  
  # Redundant transcriptleri kaldır
  ovary_tpm_clean <- ovary_tpm_clean[
    !transcript_id %in% merge_ids
  ]
}

