    parts <- trimws(strsplit(line, ",", fixed = TRUE)[[1]])
    
    if (length(parts) == 6) {
      
      out[[k]] <- data.frame(
        transcript_info = current_transcript,
        Protein  = parts[1],
        Position = as.numeric(parts[2]),
        Motif    = parts[3],
        Kmer     = parts[4],
        Zscore   = as.numeric(parts[5]),
        Pvalue   = as.numeric(parts[6]),
        stringsAsFactors = FALSE
      )
      
      k <- k + 1
    }
  }
}

